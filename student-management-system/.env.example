# Runtime environment: development | test | production
NODE_ENV=development

# HTTP server
HOST=0.0.0.0
PORT=3000

# Logging: fatal | error | warn | info | debug | trace | silent
# Defaults: debug in development, silent in test, info in production
LOG_LEVEL=debug

# Local PostgreSQL container (use a secret manager in production)
POSTGRES_DB=student_management
POSTGRES_USER=student_app
POSTGRES_PASSWORD=change_me_for_local_only
POSTGRES_PORT=5432

# Runtime connection (URL-encode special characters in credentials)
DATABASE_URL=postgresql://student_app:change_me_for_local_only@127.0.0.1:5432/student_management

# Optional direct connection for migrations when DATABASE_URL uses a pooler
# DIRECT_URL=postgresql://migration_user:change_me@127.0.0.1:5432/student_management

# Pool size is per application instance
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT_MS=5000

# Authentication (use a random secret from a secret manager in production)
JWT_SECRET=replace_with_at_least_32_random_characters
JWT_ACCESS_TOKEN_TTL_SECONDS=900
