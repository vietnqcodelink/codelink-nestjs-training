meta {
  name: Create student
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/students
  body: json
  auth: bearer
}

headers {
  content-type: application/json
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "name": "Bruno Student",
    "email": "{{studentEmail}}",
    "dateOfBirth": "2000-01-15"
  }
}

vars:pre-request {
  studentEmail: test2@gmail.com
}

script:pre-request {
  bru.setVar("studentEmail", `bruno.student.${Date.now()}@example.com`);
}

script:post-response {
  if (res.status === 201 && res.body?.id) {
    bru.setVar("studentId", res.body.id);
  }
}

tests {
  test("creates a student", function() {
    expect(res.status).to.equal(201);
    expect(res.body).to.include({
      name: "Bruno Student",
      email: bru.getVar("studentEmail")
    });
    expect(res.body.id).to.be.a("string");
  });
}
