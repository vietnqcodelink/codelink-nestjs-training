meta {
  name: Assign custom role to user
  type: http
  seq: 8
}

put {
  url: {{baseUrl}}/rbac/users/{{rbacTargetUserId}}/roles
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

headers {
  content-type: application/json
}

body:json {
  {
    "roleIds": ["{{systemUserRoleId}}", "{{rbacRoleId}}"]
  }
}

tests {
  test("assigns the custom role while retaining USER", function() {
    expect(res.status).to.equal(200);
    expect(res.body.userId).to.equal(bru.getVar("rbacTargetUserId"));

    const roleNames = res.body.roles.map((role) => role.name);
    expect(roleNames).to.include("USER");
    expect(roleNames).to.include(bru.getVar("rbacRoleName"));
  });
}
