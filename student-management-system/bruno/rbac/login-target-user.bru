meta {
  name: Resolve target user
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}

headers {
  content-type: application/json
}

body:json {
  {
    "email": "{{rbacTargetEmail}}",
    "password": "{{rbacTargetPassword}}"
  }
}

script:post-response {
  if (res.status === 200 && res.body?.user?.id) {
    bru.setVar("rbacTargetUserId", res.body.user.id);
  }
}

tests {
  test("resolves the target user ID without replacing the admin token", function() {
    expect(res.status).to.equal(200);
    expect(res.body.user.id).to.be.a("string").and.not.empty;
  });
}
