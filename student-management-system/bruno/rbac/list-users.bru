meta {
  name: Search users
  type: http
  seq: 9
}

get {
  url: {{baseUrl}}/rbac/users?page=1&limit=10&search=
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

tests {
  test("returns a paginated safe user directory", function() {
    expect(res.status).to.equal(200);
    expect(res.body.data).to.be.an("array");
    expect(res.body.meta).to.include({ page: 1, limit: 10 });
  });

  test("does not expose password hashes", function() {
    for (const user of res.body.data) {
      expect(user).not.to.have.property("passwordHash");
    }
  });
}
