meta {
  name: Create enrollment student
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/students
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

headers {
  content-type: application/json
}

script:pre-request {
  bru.setVar("enrollmentStudentEmail", `enrollment.${Date.now()}@example.com`);
}

body:json {
  {
    "name": "Enrollment Student",
    "email": "{{enrollmentStudentEmail}}",
    "dateOfBirth": "2000-01-15"
  }
}

script:post-response {
  if (res.status === 201 && res.body?.id) {
    bru.setVar("enrollmentStudentId", res.body.id);
  }
}

tests {
  test("creates a student for enrollment", function() {
    expect(res.status).to.equal(201);
    expect(res.body.id).to.be.a("string");
  });
}
