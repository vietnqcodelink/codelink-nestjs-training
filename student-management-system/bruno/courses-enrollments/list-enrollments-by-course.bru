meta {
  name: List enrollments by course
  type: http
  seq: 8
}

get {
  url: {{baseUrl}}/enrollments?page=1&limit=20&courseId={{courseId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

tests {
  test("returns enrollment details for the course", function() {
    expect(res.status).to.equal(200);
    expect(res.body.data.map((item) => item.studentId)).to.include(
      bru.getVar("enrollmentStudentId"),
    );
  });
}
