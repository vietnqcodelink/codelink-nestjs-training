meta {
  name: Get course
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/courses/{{courseId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

tests {
  test("returns the created course", function() {
    expect(res.status).to.equal(200);
    expect(res.body.id).to.equal(bru.getVar("courseId"));
  });
}
