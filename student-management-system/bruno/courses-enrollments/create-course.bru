meta {
  name: Create course
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/courses
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

headers {
  content-type: application/json
}

script:pre-request {
  bru.setVar("courseCode", `BRUNO-${Date.now()}`);
}

body:json {
  {
    "name": "Bruno Course",
    "code": "{{courseCode}}",
    "description": "Course created by the Bruno collection"
  }
}

script:post-response {
  if (res.status === 201 && res.body?.id) {
    bru.setVar("courseId", res.body.id);
  }
}

tests {
  test("creates a normalized course", function() {
    expect(res.status).to.equal(201);
    expect(res.body).to.include({
      name: "Bruno Course",
      code: bru.getVar("courseCode")
    });
  });
}
