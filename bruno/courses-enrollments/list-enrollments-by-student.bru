meta {
  name: List enrollments by student
  type: http
  seq: 7
}

get {
  url: {{baseUrl}}/enrollments?page=1&limit=20&studentId={{enrollmentStudentId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

tests {
  test("returns enrollment details for the student", function() {
    expect(res.status).to.equal(200);
    expect(res.body.data[0]).to.have.all.keys(
      "id",
      "studentId",
      "courseId",
      "createdAt",
      "student",
      "course",
    );
  });
}
