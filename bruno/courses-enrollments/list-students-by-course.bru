meta {
  name: List students by course
  type: http
  seq: 9
}

get {
  url: {{baseUrl}}/students?page=1&limit=20&courseId={{courseId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

tests {
  test("returns students enrolled in the selected course", function() {
    expect(res.status).to.equal(200);
    expect(res.body.data.map((student) => student.id)).to.include(
      bru.getVar("enrollmentStudentId"),
    );
    expect(res.body.meta).to.include({ page: 1, limit: 20 });
  });
}
