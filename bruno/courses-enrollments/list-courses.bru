meta {
  name: List courses
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/courses?page=1&limit=20
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

tests {
  test("returns paginated courses", function() {
    expect(res.status).to.equal(200);
    expect(res.body.data).to.be.an("array");
    expect(res.body.meta).to.include({ page: 1, limit: 20 });
  });
}
