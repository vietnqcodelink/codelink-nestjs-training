meta {
  name: Register target user
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/auth/register
  body: json
  auth: none
}

headers {
  content-type: application/json
}

body:json {
  {
    "email": "{{rbacTargetEmail}}",
    "password": "{{rbacTargetPassword}}"
  }
}

tests {
  test("creates or reuses the target account", function() {
    expect([201, 409]).to.include(res.status);
  });
}
