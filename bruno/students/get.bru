meta {
  name: Get student
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/students/{{studentId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

tests {
  test("returns the created student", function() {
    expect(res.status).to.equal(200);
    expect(res.body.id).to.equal(bru.getVar("studentId"));
  });
}
